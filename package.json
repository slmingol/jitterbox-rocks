{
  "name": "jitterbox-rocks",
  "version": "1.6.7",
  "description": "A comprehensive music trivia game with daily challenges and practice mode",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.ts",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "seed": "ts-node server/scripts/seed.ts",
    "generate-billboard-games": "ts-node server/scripts/generateBillboardGames.ts",
    "collect-data": "ts-node server/scripts/collectAllData.ts",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "music",
    "trivia",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "better-sqlite3": "^9.6.0",
    "uuid": "^11.0.0",
    "multer": "^2.0.0",
    "date-fns": "^4.0.0",
    "node-cron": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.15",
    "@types/node": "^20.8.9",
    "@types/multer": "^2.0.0",
    "@types/better-sqlite3": "^9.0.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^6.0.0",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "concurrently": "^10.0.0"
  }
}
