{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "date-fns"
      ],
      "allowedVersions": "<4.0.0",
      "description": "date-fns v4 is ESM-only, incompatible with react-scripts (CRA)"
    },
    {
      "matchPackageNames": [
        "better-sqlite3",
        "@types/better-sqlite3"
      ],
      "allowedVersions": "<10.0.0",
      "description": "better-sqlite3 v10+ crashes on node:18-alpine (native module segfault)"
    },
    {
      "matchPackageNames": [
        "@types/uuid"
      ],
      "enabled": false,
      "description": "uuid v9 bundles its own types; @types/uuid v11 is an empty stub that breaks compilation"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
