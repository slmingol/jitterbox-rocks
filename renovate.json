{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "date-fns"
      ],
      "allowedVersions": "<4.0.0",
      "description": "date-fns v4 is ESM-only, incompatible with react-scripts (CRA)"
    },
    {
      "matchPackageNames": [
        "better-sqlite3",
        "@types/better-sqlite3"
      ],
      "allowedVersions": "<10.0.0",
      "description": "better-sqlite3 v10+ crashes on node:18-alpine (native module segfault)"
    },
    {
      "matchPackageNames": [
        "@types/uuid"
      ],
      "enabled": false,
      "description": "uuid v9 bundles its own types; @types/uuid v11 is an empty stub that breaks compilation"
    },
    {
      "matchPackageNames": ["uuid"],
      "allowedVersions": "<12.0.0",
      "description": "pinned to v11; v12+ untested"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["client/package.json"],
      "allowedVersions": "<5.0.0",
      "description": "react-scripts@5 peer dep caps typescript at ^3||^4"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["package.json"],
      "allowedVersions": "<6.0.0",
      "description": "typescript v6+ breaks server CI"
    },
    {
      "matchDepNames": ["node"],
      "matchManagers": ["dockerfile"],
      "allowedVersions": "<24",
      "description": "node:24 breaks better-sqlite3 v9 native compilation"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
